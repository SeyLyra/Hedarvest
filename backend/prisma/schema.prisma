generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farmer {
  id                    Int      @id @default(autoincrement())
  email                 String?  @unique
  password              String?
  memberNumber          String   @unique
  phoneNumber           String
  nationalId            String?
  walletAddress         String   @unique
  hederaAccountId       String?  @unique // Hedera account ID (0.0.xxxxx format)
  encryptedPrivateKey   String?  // Encrypted private key for custodial accounts
  isCustodial           Boolean  @default(false) // True if wallet is managed by platform
  agentId               Int?
  agent                 Agent?   @relation(fields: [agentId], references: [id])
  otpRequest            OtpRequest?
  deposits              GrainDeposit[]
  deliveryRequests      DeliveryRequest[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Agent {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  passwordHash   String
  phoneNumber    String?
  walletAddress  String?  @unique
  location       String?
  status         String   @default("pending") // pending, approved, rejected
  isActive       Boolean  @default(true)
  commissionRate Decimal  @default(0.05)
  deposits       GrainDeposit[]
  farmers        Farmer[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model GrainDeposit {
  id              Int      @id @default(autoincrement())
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  farmerId        Int
  agent           Agent?   @relation(fields: [agentId], references: [id])
  agentId         Int?
  grainType       String
  weightKg        Decimal
  qualityGrade    String?
  moisturePercent Decimal?
  tokensMinted    Decimal   @default(0)
  hederaTxId      String?
  depositedAt     DateTime  @default(now())
}

model Warehouse {
  id                    Int      @id @default(autoincrement())
  email                 String   @unique
  password              String
  name                  String
  warehouseId           String   @unique // e.g., WH001
  walletAddress         String   @unique
  hederaAccountId       String?  @unique
  encryptedPrivateKey   String?
  isCustodial           Boolean  @default(true)
  address               String?
  city                  String?
  state                 String?
  country               String?
  phone                 String?
  manager               String?
  capacity              Decimal  @default(0)
  status                String   @default("active") // active, inactive, maintenance
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Pool {
  id                    Int      @id @default(autoincrement())
  grainType             String   @unique
  poolAddress           String   @unique
  lendingToken          String
  lendingTokenAddress   String?
  collateralToken       String
  lpToken               String
  oracleAddress         String?
  totalLiquidity        Decimal  @default(0)
  liquidity             Decimal  @default(0) // Alias for totalLiquidity
  totalBorrows          Decimal  @default(0)
  totalReserves         Decimal  @default(0)
  utilizationRate       Decimal  @default(0)
  currentAPR            Decimal  @default(0)
  apr                   Decimal  @default(0) // Alias for currentAPR
  baseLtv               Decimal  @default(0.8)
  protocolFee           Decimal  @default(0.1)
  riskPremium           Decimal  @default(0.05)
  debtCeiling           Decimal  @default(1000000)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OtpRequest {
  id         Int      @id @default(autoincrement())
  farmerId   Int      @unique
  code       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  farmer     Farmer   @relation(fields: [farmerId], references: [id])
}

model DeliveryRequest {
  id                Int      @id @default(autoincrement())
  farmer            Farmer   @relation(fields: [farmerId], references: [id])
  farmerId          Int
  warehouseId       String   // Reference to warehouse operator
  cropType          String
  variety           String?
  estimatedWeight   Decimal
  unit              String   @default("kg")
  estimatedGrade    String?
  moistureContent   Decimal?
  temperature       Decimal?
  scheduledDate     DateTime
  location          String?
  status            String   @default("pending") // pending, confirmed, in_transit, received, completed, cancelled
  notes             String?
  photos            Json?    // Array of photo URLs/paths
  incomingDelivery  IncomingDelivery?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IncomingDelivery {
  id                  Int              @id @default(autoincrement())
  deliveryRequest     DeliveryRequest  @relation(fields: [deliveryRequestId], references: [id])
  deliveryRequestId   Int              @unique
  farmerName          String
  farmerId            Int
  cropType            String
  weight              Decimal          // Actual measured weight
  unit                String           @default("kg")
  grade               String?
  arrivalDate         DateTime
  status              String           @default("pending") // pending, inspecting, verified, rejected
  priority            String           @default("medium") // low, medium, high
  estimatedValue      Decimal?
  storageLocation     String?
  notes               String?
  qualityInspectionId Int?             // Link to quality inspection record
  grainDepositId      Int?             // Link to final grain deposit after verification
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}