generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farmer {
  id                    Int      @id @default(autoincrement())
  email                 String?  @unique
  password              String?
  memberNumber          String   @unique
  phoneNumber           String
  nationalId            String?
  walletAddress         String   @unique
  hederaAccountId       String?  @unique // Hedera account ID (0.0.xxxxx format)
  encryptedPrivateKey   String?  // Encrypted private key for custodial accounts
  isCustodial           Boolean  @default(false) // True if wallet is managed by platform
  agentId               Int?
  otpRequest            OtpRequest?
  deposits              GrainDeposit[]
  deliveries            Delivery[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model Warehouse {
  id                    Int      @id @default(autoincrement())
  email                 String   @unique
  password              String
  name                  String
  warehouseId           String   @unique // e.g., WH001
  walletAddress         String   @unique
  hederaAccountId       String?  @unique
  encryptedPrivateKey   String?
  isCustodial           Boolean  @default(true)
  address               String?
  city                  String?
  state                 String?
  country               String?
  phone                 String?
  manager               String?
  capacity              Decimal  @default(0)
  status                String   @default("active") // active, inactive, maintenance
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  GrainDeposits         GrainDeposit[]
}

model GrainDeposit {
  id              Int      @id @default(autoincrement())
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  farmerId        Int
  warehouse       Warehouse?   @relation(fields: [warehouseId], references: [id])
  warehouseId     Int
  agentId         Int?
  grainType       String
  weightKg        Decimal
  qualityGrade    String?
  moisturePercent Decimal?
  tokensMinted    Decimal   @default(0)
  hederaTxId      String?
  depositedAt     DateTime  @default(now())
}

model OtpRequest {
  id         Int      @id @default(autoincrement())
  farmerId   Int      @unique
  code       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  farmer     Farmer   @relation(fields: [farmerId], references: [id])
}

model Delivery {
  id                  Int              @id @default(autoincrement())
  farmer              Farmer           @relation(fields: [farmerId], references: [id])
  farmerId            Int
  warehouseId         String           // Reference to warehouse operator (e.g., WH001)

  // Crop information
  cropType            String
  variety             String?
  unit                String           @default("kg")

  // Estimated data (from farmer)
  estimatedWeight     Decimal
  estimatedGrade      String?

  // Actual data (measured at warehouse)
  actualWeight        Decimal?         // Measured weight at warehouse
  actualGrade         String?          // Grade after quality inspection
  moistureContent     Decimal?
  temperature         Decimal?

  // Scheduling
  scheduledDate       DateTime
  arrivalDate         DateTime?        // When it actually arrived

  // Status tracking - combined flow
  status              String           @default("pending")
  // Flow: pending → confirmed → in_transit → arrived → inspecting → verified/rejected

  priority            String           @default("medium") // low, medium, high
  estimatedValue      Decimal?
  storageLocation     String?
  location            String?          // Pickup/origin location
  notes               String?
  photos              Json?            // Array of photo URLs/paths

  // Links to final records
  grainDepositId      Int?             // Link to final grain deposit after verification

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Transaction {
  id          Int      @id @default(autoincrement())
  kind        String   // delivery_created, delivery_received, inspection_completed, tokens_minted, etc.
  ref         String   // Reference to related entity (e.g., "delivery_123")
  entity      String   // Entity type (Delivery, GrainDeposit, etc.)
  meta        Json?    // Additional metadata
  createdAt   DateTime @default(now())

  @@index([kind])
  @@index([ref])
  @@index([createdAt])
}